---
import Layout from '../../../layouts/Layout.astro';
import Project from '../../../components/sections/Project.astro';
import { projects, themes } from '../../../config/cv.json';
import { getLocaleMessages } from '../../../i18n/ui';

export function getStaticPaths() {
  return themes.map((theme) => ({ params: { slug: theme.slug }, props: { theme } }));
}

const { theme } = Astro.props;
const messages = getLocaleMessages('fr');
const translatedTheme = messages.themes[theme.slug as keyof typeof messages.themes];
const themeProjects = projects.filter((project) => project.theme === theme.slug);
---

<Layout title={`${translatedTheme.name} | Projets`} locale="fr">
  <main class="bg-background">
    <div class="container mx-auto px-6 py-12">
      <a href={`${import.meta.env.BASE_URL}fr/`} class="text-primary hover:underline">{messages.allThemes}</a>
      <header class="mt-6 text-center">
        <h1 class="text-3xl font-semibold lg:text-4xl">{translatedTheme.name}</h1>
        <p class="mt-4 text-offset">{translatedTheme.description}</p>
      </header>
      {themeProjects.length > 0 ? (
        <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
          {themeProjects.map((project) => <Project imageUrl={project.imageUrl} title={project.title} type={project.theme === 'system-programming' ? 'Programmation système' : project.type} link={project.link} />)}
        </div>
      ) : (
        <p class="mt-10 text-center text-offset">{messages.emptyProjects}</p>
      )}
    </div>
  </main>
</Layout>
