---
import { getCollection } from 'astro:content';
import BlogPage from '../../../components/sections/blog/BlogPage.astro';
import type { Page as AstroPage } from 'astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  page: AstroPage<CollectionEntry<'blogs'>>;
}

export async function getStaticPaths({ paginate }) {
  const blogs = await getCollection('blogs');
  const sortedBlogs = blogs.sort((a, b) => new Date(b.data.datetime).getTime() - new Date(a.data.datetime).getTime());
  return paginate(sortedBlogs, { pageSize: 5 });
}
---

<BlogPage page={Astro.props.page} locale="fr" />
