---
import Layout from '../../layouts/Layout.astro';
import Project from '../../components/sections/Project.astro';
import { projects, themes } from '../../config/cv.json';
import { sitePath } from '../../i18n/routing';
import { getLocaleMessages } from '../../i18n/ui';

export function getStaticPaths() {
    return themes.map((theme) => ({
        params: { slug: theme.slug },
        props: { theme },
    }));
}

const { theme } = Astro.props;
const messages = getLocaleMessages('en');
const themeProjects = projects.filter((project) => project.theme === theme.slug);
---

<Layout title={`${theme.name} | Projects`}>
    <main class="bg-background">
        <div class="container mx-auto px-6 py-12">
            <a href={sitePath()} class="text-primary hover:underline">← All themes</a>
            <header class="mt-6 text-center">
                <h1 class="text-3xl font-semibold lg:text-4xl">{theme.name}</h1>
                <p class="mt-4 text-offset">{theme.description}</p>
            </header>

            {themeProjects.length > 0 ? (
                <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
                    {themeProjects.map((project) => (
                        <Project
                            imageUrl={project.imageUrl}
                            title={project.title}
                            type={project.type}
                            link={project.link}
                            objectives={project.objectives}
                            technologies={project.technologies}
                            skills={project.skills}
                            functionalVideo={project.functionalVideo}
                            technicalVideo={project.technicalVideo}
                            labels={messages}
                        />
                    ))}
                </div>
            ) : (
                <p class="mt-10 text-center text-offset">Projects in this area will be added soon.</p>
            )}
        </div>
    </main>
</Layout>
