---
import { Icon } from "astro-icon/components";
import ThemeToggle from "../common/ThemeToggle.astro";
import { basic } from "../../config/cv.json";
import { getLocaleMessages, type Locale } from "../../i18n/ui";

const { locale = 'en' } = Astro.props as { locale?: Locale };
const messages = getLocaleMessages(locale);
---

<header class="bg-background py-4">
  <div class="container max-w-6xl mx-auto flex justify-between items-center px-4 md:px-8">
    <!-- Logo -->
    <div class="text-2xl font-bold">
      <a href={import.meta.env.BASE_URL} class="hover:text-offset">{basic?.name}</a>
    </div>

    <div class="flex gap-5">
      <!-- PC Menu -->
      <nav class="hidden sm:flex space-x-6 items-center">
        <a href={`${import.meta.env.BASE_URL}${locale === 'fr' ? 'fr/' : ''}#experience`} class="hover:text-offset">{messages.about}</a>
        <label class="sr-only" for="language-select">{messages.language}</label>
        <select id="language-select" class="rounded border border-default bg-background px-2 py-1 text-sm" aria-label={messages.language}>
          <option value="en" selected={locale === 'en'}>English</option>
          <option value="fr" selected={locale === 'fr'}>Français</option>
        </select>
      </nav>

      <!-- Mobile Menu Button -->
      <div class="sm:hidden flex">
        <button id="menu-btn" class="focus:outline-none" aria-label={locale === 'fr' ? 'Ouvrir le menu' : 'Open menu'}>
          <Icon name="Menu" class="size-6"/>
        </button>
      </div>

      <ThemeToggle />
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden sm:hidden">
    <a href={`${import.meta.env.BASE_URL}${locale === 'fr' ? 'fr/' : ''}#experience`} class="block px-4 py-2 hover:bg-background-offset">{messages.about}</a>
    <label class="block px-4 pt-3 text-sm text-offset" for="mobile-language-select">{messages.language}</label>
    <select id="mobile-language-select" class="m-2 rounded border border-default bg-background px-2 py-1 text-sm" aria-label={messages.language}>
      <option value="en" selected={locale === 'en'}>English</option>
      <option value="fr" selected={locale === 'fr'}>Français</option>
    </select>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>

<script>
  const base = document.documentElement.dataset.base ?? '/';
  const selects = document.querySelectorAll<HTMLSelectElement>('#language-select, #mobile-language-select');

  function switchLocale(locale: string) {
    const path = window.location.pathname;
    const relativePath = path.startsWith(base) ? path.slice(base.length) : path.replace(/^\//, '');
    const withoutLocale = relativePath.replace(/^fr\/?/, '');
    const nextPath = locale === 'fr' ? `${base}fr/${withoutLocale}` : `${base}${withoutLocale}`;
    window.location.href = `${nextPath}${window.location.search}${window.location.hash}`;
  }

  selects.forEach((select) => select.addEventListener('change', () => switchLocale(select.value)));
</script>
