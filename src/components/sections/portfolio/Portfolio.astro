---
import { themes } from '../../../config/cv.json';
import { getLocaleMessages, type Locale } from '../../../i18n/ui';
import { sitePath } from '../../../i18n/routing';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const messages = getLocaleMessages(locale);
---

<section id="projects" class="bg-background">
    <div class="container px-6 py-8 mx-auto">
        <h2 class="text-3xl font-semibold text-center capitalize lg:text-4xl">
            {messages.projects}
        </h2>
        <p class="mt-4 text-center text-offset">
            {messages.projectsIntro}
        </p>

        <div class="grid grid-cols-1 gap-8 mt-8 xl:mt-12 xl:gap-12 md:grid-cols-2 xl:grid-cols-3">
            {themes.map((theme) => (
                <a
                    href={sitePath(`themes/${theme.slug}`, locale)}
                    class="group rounded-xl border border-default bg-background-offset p-5 shadow-lg transition hover:-translate-y-1"
                >
                    <h3 class="text-2xl font-semibold group-hover:text-primary">{locale === 'fr' ? messages.themes[theme.slug as keyof typeof messages.themes]!.name : theme.name}</h3>
                    <p class="mt-3 text-offset">{locale === 'fr' ? messages.themes[theme.slug as keyof typeof messages.themes]!.description : theme.description}</p>
                    <span class="mt-6 inline-block font-semibold text-primary">{messages.viewProjects}</span>
                </a>
            ))}
        </div>
    </div>
</section>
