---
import CardListItem from './CardListItem.astro';

interface Item {
  title: string;
  sub_title: string;
  years: string;
  details?: string;
}

import { getLocaleMessages, type Locale } from '../../../i18n/ui';

const { title, items, locale = 'en', section } = Astro.props as { title: string; items: Item[]; locale?: Locale; section?: 'experience' | 'education' };
const translations = getLocaleMessages(locale);
---

<section class="py-14 bg-background">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl lg:text-4xl font-semibold text-center mb-12">
        {title}
    </h2>

    <ul class="space-y-8">
      {items.map((item: Item) => (
        <CardListItem
          title={locale === 'fr' && section ? translations[section === 'experience' ? 'experiences' : 'education'][items.indexOf(item)]?.title ?? item.title : item.title}
          sub_title={item.sub_title}
          years={item.years}
          details={locale === 'fr' && section ? translations[section === 'experience' ? 'experiences' : 'education'][items.indexOf(item)]?.details ?? item.details : item?.details}
        />
      ))}
    </ul>
  </div>
</section>
