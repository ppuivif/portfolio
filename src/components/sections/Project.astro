---
const { imageUrl, title, type, link, objectives, technologies, skills, functionalVideo, technicalVideo, labels } = Astro.props;
const videoId = (url) => {
    if (!url) return '';
    try {
        const parsed = new URL(url);
        if (parsed.hostname === 'youtu.be') return parsed.pathname.slice(1);
        if (parsed.hostname.endsWith('youtube.com')) return parsed.searchParams.get('v') || parsed.pathname.split('/').filter(Boolean).at(-1) || '';
    } catch {}
    return '';
};
const functionalId = videoId(functionalVideo);
const technicalId = videoId(technicalVideo);
---

<article class="overflow-hidden rounded-lg border border-gray-300 bg-surface shadow-md dark:border-gray-600 dark:shadow-black/40">
    <div class="relative m-4 h-64 overflow-hidden rounded-md group" tabindex="0">
        <img
            src={`${import.meta.env.BASE_URL}${imageUrl}`}
            alt={title}
            class="h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-0 group-focus:opacity-0"
            loading="lazy"
        />
        <div class="absolute inset-0 flex flex-col justify-center overflow-y-auto bg-gray-900/90 px-6 py-4 text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus:opacity-100">
            <h2 class="text-xl font-semibold">{title}</h2>
            <p class="mt-2 text-sm"><strong>{labels.projectObjectives} :</strong> {objectives || type}</p>
            <p class="mt-2 text-sm"><strong>{labels.projectTechnologies} :</strong> {technologies || labels.projectDetailsMissing}</p>
            <p class="mt-2 text-sm"><strong>{labels.projectSkills} :</strong> {skills || labels.projectDetailsMissing}</p>
        </div>
    </div>

    <div class="space-y-3 p-6 text-sm">
        <a class="block text-primary hover:underline" href={link} target="_blank" rel="noopener noreferrer">{labels.projectGithub}</a>
        {functionalId ? (
            <details class="group">
                <summary class="list-none cursor-pointer text-primary hover:underline [&::-webkit-details-marker]:hidden"><span aria-hidden="true" class="mr-2 rounded-sm bg-orange-500 group-open:hidden">▶️</span><span aria-hidden="true" class="mr-2 hidden rounded-sm bg-orange-500 group-open:inline">🔽</span>{labels.projectFunctionalVideo.replace('▶️ ', '')}</summary>
                <div class="mt-3 aspect-video"><iframe class="h-full w-full rounded" src={`https://www.youtube-nocookie.com/embed/${functionalId}`} title={`${labels.projectFunctionalVideo} ${title}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
            </details>
        ) : null}
        {technicalId ? (
            <details class="group">
                <summary class="list-none cursor-pointer text-primary hover:underline [&::-webkit-details-marker]:hidden"><span aria-hidden="true" class="mr-2 rounded-sm bg-orange-500 group-open:hidden">▶️</span><span aria-hidden="true" class="mr-2 hidden rounded-sm bg-orange-500 group-open:inline">🔽</span>{labels.projectTechnicalVideo.replace('▶️ ', '')}</summary>
                <div class="mt-3 aspect-video"><iframe class="h-full w-full rounded" src={`https://www.youtube-nocookie.com/embed/${technicalId}`} title={`${labels.projectTechnicalVideo} ${title}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
            </details>
        ) : null}
    </div>
</article>
